# Public backend identifiers only. Never place secrets in EXPO_PUBLIC variables.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Optional private Anthropic metadata service. Claude is the only permitted paid model.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
THREAD_SERVICE_TOKEN=
# Local reconstruction settings are created privately in .env.local-reconstruction.
# Reconstruction uses local COLMAP/OpenMVS/U2Net; no paid reconstruction credentials.
